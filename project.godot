config_version=5
[application]
config/name="Emberwake - Blonde Player v115"
run/main_scene="res://scenes/prologue.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1024
window/size/min_height=640
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.05,0.065,0.09,1)
[physics]
common/physics_ticks_per_second=120
[audio]
driver/enable_input=false




[autoload]
HarborHome="*res://scripts/opening/harbor_home.gd"
