shader_type canvas_item;
render_mode unshaded;
uniform sampler2D scene_color : hint_screen_texture, filter_linear_mipmap, repeat_disable;
uniform vec2 world_origin;
uniform vec2 world_dx;
uniform vec2 world_dy;
uniform vec2 player_ground;
uniform vec2 ray_origin;
uniform vec2 hero_center;
uniform vec2 hero_radius;
uniform vec2 facing=vec2(1.0,0.0);
uniform float sight_range=10.0;
uniform float cone_cos=0.5;
uniform float aim_height=0.0;
uniform sampler2D ray_lengths : filter_nearest, repeat_enable;
// Alpha-only protection: a visible tall billboard is not ground behind itself.
uniform sampler2D actor_mask : filter_nearest, repeat_disable;
uniform sampler2D weapon_mask : filter_nearest, repeat_disable;
uniform float actor_enabled=0.0;
uniform float weapon_enabled=0.0;
uniform bool actor_flip=false;
uniform bool weapon_flip=false;
uniform vec2 actor_origin;
uniform vec2 actor_dx=vec2(1.0,0.0);
uniform vec2 actor_dy=vec2(0.0,1.0);
uniform vec2 weapon_origin;
uniform vec2 weapon_dx=vec2(1.0,0.0);
uniform vec2 weapon_dy=vec2(0.0,1.0);
uniform sampler2D carry_mask : filter_nearest, repeat_disable;
uniform float carry_enabled=0.0;
uniform bool carry_flip=false;
uniform bool carry_flip_v=false;
uniform vec2 carry_origin;
uniform vec2 carry_dx=vec2(1.0,0.0);
uniform vec2 carry_dy=vec2(0.0,1.0);
uniform sampler2D carry_off_mask : filter_nearest, repeat_disable;
uniform float carry_off_enabled=0.0;
uniform bool carry_off_flip=false;
uniform bool carry_off_flip_v=false;
uniform vec2 carry_off_origin;
uniform vec2 carry_off_dx=vec2(1.0,0.0);
uniform vec2 carry_off_dy=vec2(0.0,1.0);
uniform sampler2D npc0_mask : filter_nearest, repeat_disable;
uniform float npc0_enabled=0.0;
uniform bool npc0_flip=false;
uniform vec2 npc0_origin;
uniform vec2 npc0_dx=vec2(1.0,0.0);
uniform vec2 npc0_dy=vec2(0.0,1.0);
uniform sampler2D npc1_mask : filter_nearest, repeat_disable;
uniform float npc1_enabled=0.0;
uniform bool npc1_flip=false;
uniform vec2 npc1_origin;
uniform vec2 npc1_dx=vec2(1.0,0.0);
uniform vec2 npc1_dy=vec2(0.0,1.0);
uniform sampler2D npc2_mask : filter_nearest, repeat_disable;
uniform float npc2_enabled=0.0;
uniform bool npc2_flip=false;
uniform vec2 npc2_origin;
uniform vec2 npc2_dx=vec2(1.0,0.0);
uniform vec2 npc2_dy=vec2(0.0,1.0);
uniform sampler2D npc3_mask : filter_nearest, repeat_disable;
uniform float npc3_enabled=0.0;
uniform bool npc3_flip=false;
uniform vec2 npc3_origin;
uniform vec2 npc3_dx=vec2(1.0,0.0);
uniform vec2 npc3_dy=vec2(0.0,1.0);
uniform sampler2D npc4_mask : filter_nearest, repeat_disable;
uniform float npc4_enabled=0.0;
uniform bool npc4_flip=false;
uniform vec2 npc4_origin;
uniform vec2 npc4_dx=vec2(1.0,0.0);
uniform vec2 npc4_dy=vec2(0.0,1.0);
uniform sampler2D npc5_mask : filter_nearest, repeat_disable;
uniform float npc5_enabled=0.0;
uniform bool npc5_flip=false;
uniform vec2 npc5_origin;
uniform vec2 npc5_dx=vec2(1.0,0.0);
uniform vec2 npc5_dy=vec2(0.0,1.0);
vec2 mask_uv(vec2 point,vec2 origin,vec2 dx,vec2 dy){
 vec2 r=point-origin;float det=dx.x*dy.y-dx.y*dy.x;
 if(abs(det)<0.000001){return vec2(-2.0);}
 return vec2((r.x*dy.y-r.y*dy.x)/det,(dx.x*r.y-dx.y*r.x)/det);
}
float in_mask(vec2 uv){return step(0.0,uv.x)*step(uv.x,1.0)*step(0.0,uv.y)*step(uv.y,1.0);}
void fragment(){
 vec2 world=world_origin+UV.x*world_dx+UV.y*world_dy;
 vec2 offset=world-player_ground;
 float distance=length(offset);
 vec2 ray_offset=world-ray_origin;
 float angle=atan(ray_offset.y,ray_offset.x);
 float ray_u=fract(angle/6.28318530718);
 float wall=texture(ray_lengths,vec2(ray_u,0.5)).r*sight_range;
 float clear=1.0-smoothstep(max(0.0,wall-0.10),wall+0.06,length(ray_offset));
 float cone=smoothstep(cone_cos-0.0151904,cone_cos+0.0150381,dot(normalize(offset+vec2(0.00001)+vec2(0.0,aim_height*0.92)),facing));
 float range_fade=1.0-smoothstep(sight_range*0.93,sight_range,distance);
 float halo=1.0-smoothstep(1.30,1.65,distance);
 float hero=1.0-smoothstep(0.94,1.04,length((UV-hero_center)/hero_radius));
 float visible=max(max(cone*range_fade,halo)*clear,hero);
 vec2 auv=mask_uv(UV,actor_origin,actor_dx,actor_dy);
 vec2 wuv=mask_uv(UV,weapon_origin,weapon_dx,weapon_dy);
 float actor_alpha=texture(actor_mask,vec2(actor_flip?1.0-auv.x:auv.x,auv.y)).a*in_mask(auv)*actor_enabled;
 float weapon_alpha=texture(weapon_mask,vec2(weapon_flip?1.0-wuv.x:wuv.x,wuv.y)).a*in_mask(wuv)*weapon_enabled;
 visible=max(visible,max(actor_alpha,weapon_alpha));
 if(carry_enabled>0.0){
  vec2 cuv=mask_uv(UV,carry_origin,carry_dx,carry_dy);
  visible=max(visible,texture(carry_mask,vec2(carry_flip?1.0-cuv.x:cuv.x,carry_flip_v?1.0-cuv.y:cuv.y)).a*in_mask(cuv)*carry_enabled);
 }
 if(carry_off_enabled>0.0){
  vec2 cuv=mask_uv(UV,carry_off_origin,carry_off_dx,carry_off_dy);
  visible=max(visible,texture(carry_off_mask,vec2(carry_off_flip?1.0-cuv.x:cuv.x,carry_off_flip_v?1.0-cuv.y:cuv.y)).a*in_mask(cuv)*carry_off_enabled);
 }
 vec2 n0=mask_uv(UV,npc0_origin,npc0_dx,npc0_dy);
 visible=max(visible,texture(npc0_mask,vec2(npc0_flip?1.0-n0.x:n0.x,n0.y)).a*in_mask(n0)*npc0_enabled);
 vec2 n1=mask_uv(UV,npc1_origin,npc1_dx,npc1_dy);
 visible=max(visible,texture(npc1_mask,vec2(npc1_flip?1.0-n1.x:n1.x,n1.y)).a*in_mask(n1)*npc1_enabled);
 vec2 n2=mask_uv(UV,npc2_origin,npc2_dx,npc2_dy);
 visible=max(visible,texture(npc2_mask,vec2(npc2_flip?1.0-n2.x:n2.x,n2.y)).a*in_mask(n2)*npc2_enabled);
 vec2 n3=mask_uv(UV,npc3_origin,npc3_dx,npc3_dy);
 visible=max(visible,texture(npc3_mask,vec2(npc3_flip?1.0-n3.x:n3.x,n3.y)).a*in_mask(n3)*npc3_enabled);
 vec2 n4=mask_uv(UV,npc4_origin,npc4_dx,npc4_dy);
 visible=max(visible,texture(npc4_mask,vec2(npc4_flip?1.0-n4.x:n4.x,n4.y)).a*in_mask(n4)*npc4_enabled);
 vec2 n5=mask_uv(UV,npc5_origin,npc5_dx,npc5_dy);
 visible=max(visible,texture(npc5_mask,vec2(npc5_flip?1.0-n5.x:n5.x,n5.y)).a*in_mask(n5)*npc5_enabled);
 vec3 sharp=textureLod(scene_color,SCREEN_UV,0.0).rgb;
 vec3 blurred=textureLod(scene_color,SCREEN_UV,3.0).rgb;
 float gray=dot(blurred,vec3(0.2126,0.7152,0.0722));
 vec3 hidden=mix(blurred,vec3(gray),0.40)*0.875;
 COLOR=vec4(mix(hidden,sharp,visible),1.0);
}
